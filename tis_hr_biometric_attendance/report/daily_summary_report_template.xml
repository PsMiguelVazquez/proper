<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="daily_summary_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Header Section -->
                    <div class="row" style="margin-bottom: 30px;">
                        <div class="col-12">
                            <div style="text-align: center; border-bottom: 3px solid #875A7B; padding-bottom: 15px;">
                                <h1 style="color: #875A7B; font-weight: bold; margin: 0; font-size: 28px;">
                                    DAILY ATTENDANCE SUMMARY
                                </h1>
                            </div>
                        </div>
                    </div>

                    <!-- Report Information Section -->
                    <div class="row" style="margin-bottom: 25px;">
                        <div class="col-6">
                            <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #875A7B; border-radius: 5px;">
                                <h4 style="color: #875A7B; margin: 0 0 10px 0; font-size: 16px;">Report Date</h4>
                                <p style="margin: 5px 0;">
                                    <strong>Summary Date:</strong>
                                    <span t-esc="date_of_summary or 'Not Specified'" style="color: #333; font-weight: bold;"/>
                                </p>
                                <p style="margin: 5px 0;">
                                    <strong>Day:</strong>
                                    <span t-esc="datetime.datetime.strptime(date_of_summary, '%Y-%m-%d').strftime('%A') if date_of_summary else 'N/A'" style="color: #666;"/>
                                </p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #875A7B; border-radius: 5px;">
                                <h4 style="color: #875A7B; margin: 0 0 10px 0; font-size: 16px;">Generation Info</h4>
                                <p style="margin: 5px 0;">
                                    <strong>Generated:</strong>
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')" style="color: #666;"/>
                                </p>
                                <p style="margin: 5px 0;">
                                    <strong>Generated By:</strong>
                                    <span t-esc="user.name" style="color: #666;"/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Summary Statistics Section -->
                    <div style="margin-bottom: 25px;">
                        <h3 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 8px; margin-bottom: 15px;">
                            Attendance Overview
                        </h3>

                        <table class="table table-sm" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <thead>
                                <tr style="background-color: #875A7B; color: white;">
                                    <th style="padding: 15px 12px; text-align: center; border: 1px solid #fff; font-size: 14px;">
                                        <strong>Total Employees</strong>
                                    </th>
                                    <th style="padding: 15px 12px; text-align: center; border: 1px solid #fff; font-size: 14px;">
                                        <strong>Present</strong>
                                    </th>
                                    <th style="padding: 15px 12px; text-align: center; border: 1px solid #fff; font-size: 14px;">
                                        <strong>Absent</strong>
                                    </th>
                                    <th style="padding: 15px 12px; text-align: center; border: 1px solid #fff; font-size: 14px;">
                                        <strong>Late Arrivals</strong>
                                    </th>
                                    <th style="padding: 15px 12px; text-align: center; border: 1px solid #fff; font-size: 14px;">
                                        <strong>Early Departures</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="background-color: #f8f9fa;">
                                    <td style="text-align: center; padding: 20px; font-size: 24px; font-weight: bold; color: #875A7B; border: 1px solid #dee2e6;">
                                        <t t-esc="total_employees or 0"/>
                                    </td>
                                    <td style="text-align: center; padding: 20px; font-size: 24px; font-weight: bold; color: #28a745; border: 1px solid #dee2e6;">
                                        <t t-esc="present_employees or 0"/>
                                    </td>
                                    <td style="text-align: center; padding: 20px; font-size: 24px; font-weight: bold; color: #dc3545; border: 1px solid #dee2e6;">
                                        <t t-esc="absent_employees or 0"/>
                                    </td>
                                    <td style="text-align: center; padding: 20px; font-size: 24px; font-weight: bold; color: #fd7e14; border: 1px solid #dee2e6;">
                                        <t t-esc="late_arrivals or 0"/>
                                    </td>
                                    <td style="text-align: center; padding: 20px; font-size: 24px; font-weight: bold; color: #6f42c1; border: 1px solid #dee2e6;">
                                        <t t-esc="early_leavings or 0"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Absent Employees Section -->
                    <div style="margin-bottom: 25px; page-break-inside: avoid;">
                        <h3 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 8px; margin-bottom: 15px;">
                            Absent Employees
                            <span style="font-size: 14px; color: #666; font-weight: normal;">
                                (<t t-esc="absent_employees or 0"/> employees)
                            </span>
                        </h3>

                        <t t-if="absent_employee_lines">
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                <thead>
                                    <tr style="background-color: #875A7B; color: white;">
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 10%;">
                                            <strong>Sl. No</strong>
                                        </th>
                                        <th style="padding: 12px 8px; border: 1px solid #fff; width: 35%;">
                                            <strong>Employee Name</strong>
                                        </th>
                                        <th style="padding: 12px 8px; border: 1px solid #fff; width: 30%;">
                                            <strong>Company/Location</strong>
                                        </th>
                                        <th style="padding: 12px 8px; border: 1px solid #fff; width: 25%;">
                                            <strong>Department</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="absent_employee_lines or []" t-as="employee">
                                        <tr t-att-style="'background-color: %s;' % ('#f8f9fa' if employee_index % 2 == 0 else '#ffffff')">
                                            <td style="text-align: center; padding: 10px 8px; border: 1px solid #dee2e6; font-weight: bold;">
                                                <t t-esc="employee_index + 1"/>
                                            </td>
                                            <td style="padding: 10px 8px; border: 1px solid #dee2e6;">
                                                <strong><t t-esc="employee.get('name', 'N/A')"/></strong>
                                            </td>
                                            <td style="padding: 10px 8px; border: 1px solid #dee2e6; color: #666;">
                                                <t t-esc="employee.get('company', 'N/A')"/>
                                            </td>
                                            <td style="padding: 10px 8px; border: 1px solid #dee2e6; color: #666;">
                                                <t t-esc="employee.get('department', 'N/A')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div style="text-align: center; padding: 30px 20px; background-color: #f8f9fa; border-radius: 8px; border: 1px solid #dee2e6;">
                                <div style="color: #28a745; font-size: 32px; margin-bottom: 15px;">
                                    ✅
                                </div>
                                <h4 style="color: #28a745; margin-bottom: 10px;">Perfect Attendance!</h4>
                                <p style="margin: 0; color: #666; font-size: 14px;">
                                    No employees were absent today.
                                </p>
                            </div>
                        </t>
                    </div>

                    <!-- Present Employees Section -->
                    <div style="page-break-inside: avoid;">
                        <h3 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 8px; margin-bottom: 15px;">
                            Present Employees Details
                            <span style="font-size: 14px; color: #666; font-weight: normal;">
                                (<t t-esc="present_employees or 0"/> employees)
                            </span>
                        </h3>

                        <t t-if="present_employee_lines">
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                <thead>
                                    <tr style="background-color: #875A7B; color: white;">
                                        <th style="padding: 10px 6px; text-align: center; border: 1px solid #fff; width: 6%;">
                                            <strong>Sl</strong>
                                        </th>
                                        <th style="padding: 10px 6px; border: 1px solid #fff; width: 22%;">
                                            <strong>Employee Name</strong>
                                        </th>
                                        <th style="padding: 10px 6px; border: 1px solid #fff; width: 18%;">
                                            <strong>Company/Location</strong>
                                        </th>
                                        <th style="padding: 10px 6px; border: 1px solid #fff; width: 15%;">
                                            <strong>Department</strong>
                                        </th>
                                        <th style="padding: 10px 6px; text-align: center; border: 1px solid #fff; width: 12%;">
                                            <strong>Check-In</strong>
                                        </th>
                                        <th style="padding: 10px 6px; text-align: center; border: 1px solid #fff; width: 12%;">
                                            <strong>Check-Out</strong>
                                        </th>
                                        <th style="padding: 10px 6px; text-align: center; border: 1px solid #fff; width: 8%;">
                                            <strong>Late</strong>
                                        </th>
                                        <th style="padding: 10px 6px; text-align: center; border: 1px solid #fff; width: 7%;">
                                            <strong>Early</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="present_employee_lines or []" t-as="employee">
                                        <tr t-att-style="'background-color: %s;' % ('#f8f9fa' if employee_index % 2 == 0 else '#ffffff')">
                                            <td style="text-align: center; padding: 8px 6px; border: 1px solid #dee2e6; font-weight: bold;">
                                                <t t-esc="employee_index + 1"/>
                                            </td>
                                            <td style="padding: 8px 6px; border: 1px solid #dee2e6;">
                                                <strong><t t-esc="employee.get('name', 'N/A')"/></strong>
                                            </td>
                                            <td style="padding: 8px 6px; border: 1px solid #dee2e6; color: #666;">
                                                <t t-esc="employee.get('company', 'N/A')"/>
                                            </td>
                                            <td style="padding: 8px 6px; border: 1px solid #dee2e6; color: #666;">
                                                <t t-esc="employee.get('department', 'N/A')"/>
                                            </td>
                                            <td style="text-align: center; padding: 8px 6px; border: 1px solid #dee2e6;">
                                                <t t-esc="employee.get('first_checkin', 'N/A')"/>
                                            </td>
                                            <td style="text-align: center; padding: 8px 6px; border: 1px solid #dee2e6;">
                                                <t t-esc="employee.get('last_checkout', 'N/A')"/>
                                            </td>
                                            <td style="text-align: center; padding: 8px 6px; border: 1px solid #dee2e6;">
                                                <span t-att-style="'color: %s; font-weight: bold;' % ('#dc3545' if employee.get('late_time', '00:00') != '00:00' else '#28a745')">
                                                    <t t-esc="employee.get('late_time', '00:00')"/>
                                                </span>
                                            </td>
                                            <td style="text-align: center; padding: 8px 6px; border: 1px solid #dee2e6;">
                                                <span t-att-style="'color: %s; font-weight: bold;' % ('#dc3545' if employee.get('early_time', '00:00') != '00:00' else '#28a745')">
                                                    <t t-esc="employee.get('early_time', '00:00')"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div style="text-align: center; padding: 30px 20px; background-color: #f8f9fa; border-radius: 8px; border: 1px solid #dee2e6;">
                                <div style="color: #fd7e14; font-size: 32px; margin-bottom: 15px;">
                                </div>
                                <h4 style="color: #fd7e14; margin-bottom: 10px;">No Present Employees</h4>
                                <p style="margin: 0; color: #666; font-size: 14px;">
                                    No employees were present today.
                                </p>
                            </div>
                        </t>
                    </div>

                    <!-- Footer Summary Section -->
                    <div class="row" style="margin-top: 30px; page-break-inside: avoid;">
                        <div class="col-12">
                            <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6;">
                                <div class="row">
                                    <div class="col-6">
                                        <h4 style="color: #875A7B; margin: 0 0 10px 0;">Daily Summary</h4>
                                        <p style="margin: 5px 0; font-size: 14px;">
                                            <strong>Report Date:</strong>
                                            <span style="color: #875A7B; font-weight: bold;">
                                                <t t-esc="date_of_summary or 'Not Specified'"/>
                                            </span>
                                        </p>
                                        <p style="margin: 5px 0; font-size: 12px; color: #666;">
                                            Attendance Rate:
                                            <span style="color: #28a745; font-weight: bold;">
                                                <t t-esc="round((present_employees or 0) * 100 / (total_employees or 1), 1) if total_employees else 0"/>%
                                            </span>
                                        </p>
                                    </div>
                                    <div class="col-6" style="text-align: right;">
                                        <div style="margin-top: 10px;">
                                            <p style="margin: 5px 0; font-size: 11px; color: #999;">
                                                Generated by: <strong><span t-esc="user.name"/></strong>
                                            </p>
                                            <p style="margin: 5px 0; font-size: 11px; color: #999;">
                                                <span t-esc="res_company.name"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>