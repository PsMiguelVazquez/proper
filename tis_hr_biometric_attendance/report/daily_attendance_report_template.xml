<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Daily Attendance Report Template -->
        <template id="daily_attendance_report_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header Section -->
                        <div class="row" style="margin-bottom: 30px;">
                            <div class="col-12">
                                <div style="text-align: center; border-bottom: 3px solid #875A7B; padding-bottom: 15px;">
                                    <h1 style="color: #875A7B; font-weight: bold; margin: 0; font-size: 28px;">
                                        DAILY ATTENDANCE REPORT
                                    </h1>
                                </div>
                            </div>
                        </div>

                        <!-- Report Information Section -->
                        <div class="row" style="margin-bottom: 25px;">
                            <div class="col-6">
                                <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #875A7B; border-radius: 5px;">
                                    <h4 style="color: #875A7B; margin: 0 0 10px 0; font-size: 16px;">Report Date</h4>
                                    <p style="margin: 5px 0;">
                                        <strong>Selected Date:</strong>
                                        <span t-esc="docs.date_of_report" t-options='{"widget": "date", "format": "dd/MM/yyyy"}' style="color: #333; font-weight: bold;"/>
                                    </p>
                                    <p style="margin: 5px 0;">
                                        <strong>Day:</strong>
                                        <span t-esc="docs.date_of_report.strftime('%A')" style="color: #333;"/>
                                    </p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #875A7B; border-radius: 5px;">
                                    <t t-set="attendance_data" t-value="docs.get_attendance_data(docs.date_of_report)"/>
                                    <h4 style="color: #28a745; margin: 0 0 10px 0; font-size: 16px;">Summary</h4>
                                    <p style="margin: 5px 0;">
                                        <strong>Employees Present:</strong>
                                        <span t-esc="len(attendance_data) if attendance_data else 0" style="color: #28a745; font-weight: bold; font-size: 18px;"/>
                                    </p>
                                    <p style="margin: 5px 0;">
                                        <strong>Report Generated:</strong>
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')" style="color: #666;"/>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Main Content Section -->
                        <t t-if="attendance_data">
                            <!-- Main Title -->
                            <div style="margin-bottom: 25px;">
                                <h3 style="color: #875A7B; border-bottom: 2px solid #875A7B; padding-bottom: 8px; margin-bottom: 15px;">
                                    Attendance Details
                                </h3>
                            </div>

                            <!-- Enhanced Attendance Table -->
                            <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                <thead>
                                    <tr style="background-color: #875A7B; color: white;">
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 8%;">
                                            <strong>Sl. No</strong>
                                        </th>
                                        <th style="padding: 12px 8px; border: 1px solid #fff; width: 25%;">
                                            <strong>Employee Name</strong>
                                        </th>
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 18%;">
                                            <strong>Check In</strong>
                                        </th>
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 18%;">
                                            <strong>Check Out</strong>
                                        </th>
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 15%;">
                                            <strong>Difference (Hrs)</strong>
                                        </th>
                                        <th style="padding: 12px 8px; text-align: center; border: 1px solid #fff; width: 16%;">
                                            <strong>Worked Hours</strong>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="attendance_data" t-as="record">
                                        <tr t-att-style="'background-color: %s;' % ('#f8f9fa' if record_index % 2 == 0 else '#ffffff')">
                                            <td style="padding: 10px 8px; text-align: center; border: 1px solid #dee2e6; font-weight: bold;">
                                                <span t-esc="record_index + 1"/>
                                            </td>
                                            <td style="padding: 10px 8px; border: 1px solid #dee2e6;">
                                                <strong><span t-esc="record['employee_name']"/></strong>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; border: 1px solid #dee2e6;">
                                                <span t-if="record['checkin']"
                                                      t-esc="record['checkin']"
                                                      t-options='{"widget": "datetime", "format": "HH:mm:ss"}'
                                                      style="color: #28a745; font-weight: bold;"/>
                                                <span t-else="" style="color: #dc3545; font-style: italic;">-</span>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; border: 1px solid #dee2e6;">
                                                <span t-if="record['checkout']"
                                                      t-esc="record['checkout']"
                                                      t-options='{"widget": "datetime", "format": "HH:mm:ss"}'
                                                      style="color: #dc3545; font-weight: bold;"/>
                                                <span t-else="" style="color: #ffc107; font-style: italic;">Not Checked Out</span>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; border: 1px solid #dee2e6;">
                                                <span t-if="record['difference'] > 0"
                                                      t-esc="'%.2f' % record['difference']"
                                                      style="color: #17a2b8; font-weight: bold;"/>
                                                <span t-else="" style="color: #6c757d; font-style: italic;">-</span>
                                            </td>
                                            <td style="padding: 10px 8px; text-align: center; border: 1px solid #dee2e6;">
                                                <span t-esc="'%.2f' % record['worked_hours']"
                                                      style="color: #875A7B; font-weight: bold;"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>

                                <!-- Summary Footer Row -->
                                <tfoot>
                                    <tr style="background-color: #e9ecef; border-top: 2px solid #875A7B;">
                                        <td colspan="4" style="padding: 12px 8px; border: 1px solid #dee2e6; font-weight: bold; color: #875A7B;">
                                            <strong>TOTALS</strong>
                                        </td>
                                        <td style="padding: 12px 8px; text-align: center; border: 1px solid #dee2e6; font-weight: bold; color: #875A7B;">
                                            <strong>Employees: <span t-esc="len(attendance_data)"/></strong>
                                        </td>
                                        <td style="padding: 12px 8px; text-align: center; border: 1px solid #dee2e6; font-weight: bold; color: #875A7B;">
                                            <strong><span t-esc="'%.2f' % sum(record['worked_hours'] for record in attendance_data)"/></strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Footer Statistics Section -->
                            <div class="row" style="margin-top: 30px; page-break-inside: avoid;">
                                <div class="col-12">
                                    <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6;">
                                        <div class="row">
                                            <div class="col-6">
                                                <h4 style="color: #875A7B; margin: 0 0 15px 0;">Attendance Statistics</h4>
                                                <div style="margin-bottom: 10px;">
                                                    <p style="margin: 5px 0; font-size: 14px;">
                                                        <strong>Total Present:</strong>
                                                        <span style="color: #28a745; font-weight: bold; font-size: 16px;">
                                                            <t t-esc="len(attendance_data)"/> employees
                                                        </span>
                                                    </p>
                                                    <p style="margin: 5px 0; font-size: 14px;">
                                                        <strong>Total Hours:</strong>
                                                        <span style="color: #875A7B; font-weight: bold; font-size: 16px;">
                                                            <t t-esc="'%.2f' % sum(record['worked_hours'] for record in attendance_data)"/> hrs
                                                        </span>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="col-6" style="text-align: right;">
                                                <h4 style="color: #875A7B; margin: 0 0 15px 0;">Report Information</h4>
                                                <div style="margin-top: 15px;">
                                                    <p style="margin: 5px 0; font-size: 11px; color: #999; text-align: right;">
                                                        Generated by: <strong><span t-esc="user.name"/></strong>
                                                    </p>
                                                    <p style="margin: 5px 0; font-size: 11px; color: #999; text-align: right;">
                                                        <span t-esc="res_company.name"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </t>
                        <t t-else="">
                            <!-- No Data Section -->
                            <div style="text-align: center; padding: 60px 20px; background-color: #f8f9fa; border-radius: 10px; margin-top: 30px;">
                                <div style="color: #6c757d; font-size: 48px; margin-bottom: 20px;">

                                </div>
                                <h3 style="color: #6c757d; margin-bottom: 15px;">No Attendance Records Found</h3>
                                <p style="color: #999; font-size: 16px; margin: 0;">
                                    No employee attendance was recorded for
                                    <strong><span t-esc="docs.date_of_report" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></strong>
                                </p>
                                <div style="margin-top: 20px; padding: 15px; background-color: #f8d7da; border-radius: 5px; display: inline-block;">
                                    <p style="color: #721c24; margin: 0; font-size: 14px;">
                                         Check if it was a holiday or weekend
                                    </p>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>