<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form -->
    <record id="view_biometric_sync_wizard_form" model="ir.ui.view">
        <field name="name">biometric.sync.wizard.form</field>
        <field name="model">biometric.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Device Users">
                <group>
                    <field name="device_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                    <field name="user_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_confirm_sync"
                            string="Sync"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action  -->
    <record id="action_biometric_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Device  Users</field>
        <field name="res_model">biometric.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
