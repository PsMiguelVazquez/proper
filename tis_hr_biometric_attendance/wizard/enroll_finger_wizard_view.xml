<odoo>
    <record id="view_enroll_finger_wizard_form" model="ir.ui.view">
        <field name="name">enroll.finger.wizard.form</field>
        <field name="model">enroll.finger.wizard</field>
        <field name="arch" type="xml">
            <form string="Enroll Finger" version="7.0">
                <group>
                    <field name="hand"/>
                    <field name="finger"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>