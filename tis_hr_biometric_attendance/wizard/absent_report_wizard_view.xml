<odoo>
    <!-- Wizard Form View -->
    <record id="view_absence_report_wizard_form" model="ir.ui.view">
        <field name="name">absence.report.wizard.form</field>
        <field name="model">absence.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Absent Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Print Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_absence_report_wizard" model="ir.actions.act_window">
        <field name="name">Absent Report</field>
        <field name="res_model">absence.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Report Menu under Custom Parent -->
    <menuitem id="menu_absence_report"
              name="Absence Report"
              parent="tis_hr_biometric_attendance.menu_attendance_manager_custom"
              action="action_absence_report_wizard"
              sequence="26"/>

</odoo>
