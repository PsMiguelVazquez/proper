<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="biometric_device_config_view_form" model="ir.ui.view">
        <field name="name">biometric.config.form</field>
        <field name="model">biometric.config</field>
        <field name="arch" type="xml">
            <form string="Biometric Device">
                <header>
                    <field name="state" widget="statusbar"
                           invisible="not is_adms"
                           statusbar_visible="not_connected,connected"/>
                    <button name="check_connection" type="object"
                            class="oe_highlight"
							string="Check Connection" invisible="not is_adms or state=='connected'"
							help="This will upload settings from software to device"/>
                    <button class="btn btn-primary" name="action_refresh_connection" string="Refresh" type="object"/>
                    <button class="btn btn-danger" name="action_restart_connection" string="Restart" type="object"/>
                    <button name="download_attendance_log" class="oe_stat_button" icon="fa-download" type="object" string="Download Attendance"/>
                    <button name="download_device_users" type="object" icon="fa-download" string="Download Device Users" class="oe_stat_button"/>
                    <button name="export_employee" type="object" icon="fa-share-square" invisible="not is_adms" string="Export Employee" class="oe_stat_button"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="test_device_connection" class="oe_stat_button"
                                invisible="is_adms"
                                icon="fa-plug" type="object" string="Test Connection"/>
                        <button name="sync_employees" class="oe_stat_button"
                                invisible="is_adms"
                                icon="fa-retweet" type="object" string="Sync Employees"/>
                        <field name="attendance_log_count" invisible="1"/>
                        <field name="command_count" invisible="1"/>
                        <button name="action_open_finger_prints"
                                type="object"
                                icon="fa-hand-o-up"
                                invisible="not is_adms"
                                string="Finger Prints"
                                class="oe_stat_button"/>
                        <button name="action_open_face"
                                type="object"
                                icon="fa-address-card"
                                invisible="not is_adms"
                                string="Face Template"
                                class="oe_stat_button"/>
                        <button name="action_open_users"
                                type="object"
                                string="Users"
                                icon="fa-user-secret"
                                class="oe_stat_button"/>
                    </div>
                    <div class="oe_title" name="title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Device Reference"/>
                        </h1>
                    </div>
                    <group colspan="4" cols="4">
                        <group>
                            <field name="device_ip" required="not is_adms"
                                   invisible="is_adms"/>
                            <field name="port" required="not is_adms"
                                   invisible="is_adms"/>
                            <field name="serial_number" required="is_adms"
                                   invisible="not is_adms"/>
                            <field name="is_adms" widget="boolean_toggle"/>
                            <field name="company_id"/>
                            <field name="last_update"/>
                            <field name="tz_num" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_password_set"/>
                            <field name="device_password" password="True"
                                   invisible="is_password_set == False"
                                   required="is_password_set == True"/>
<!--                                   attrs="{'invisible':[('is_password_set','=', False)], 'required': [('is_password_set', '=', True)]}"/>-->
                            <field name="time_zone"/>
                            <field name="used_for"/>
                            <field name="is_status_number_based" invisible="used_for!='both' or not is_adms"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="adms_settings" string="Adms Settings"
                              invisible="not is_adms">
                            <group>
                                <field name="delay"/>
                                <field name="error_delay"/>
                                <field name="real_time"/>
                                <field name="trans_interval"/>
                            </group>
                        </page>
                        <page name="attendance_status_code" string="Status Codes"
                              invisible="not is_adms">
                            <field name="attendance_status_ids">
                                <list string="Status Codes">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="activity_type"/>
                                </list>
                            </field>
                        </page>
                        <page name="op_stamp_log" string="Op Stamp Log"
                              invisible="1">
                            <field name="op_stamp_log_ids">
                                <list string="Logs">
                                    <field name="name"/>
                                    <field name="log_date"/>
                                    <field name="log_text"/>
                                    <field name="opStamp"/>
                                </list>
                            </field>
                        </page>
                        <page name="attendance_data_logs" string="Attendance Data Logs" invisible="not is_adms">
                            <field name="attendance_data_log_ids">
                                <list string="Data Logs" create="0" edit="0">
                                    <field name="log_code"/>
                                    <field name="description"/>
                                    <field name="operator"/>
                                    <field name="op_time"/>
                                    <field name="value_1"/>
                                    <field name="value_2"/>
                                    <field name="value_3"/>
                                    <field name="reserved"/>
                                    <field name="opStamp"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="log_code"/>
                                            <field name="description"/>
                                            <field name="op_time"/>
                                            <field name="operator"/>
                                        </group>
                                        <group>
                                            <field name="value_1"/>
                                            <field name="value_2"/>
                                            <field name="value_3"/>
                                            <field name="reserved"/>
                                            <field name="opStamp"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page name="device_commands" string="Device Commands" invisible="not is_adms">
                            <field name="command_ids">
                                <list string="Device Commands" create="1" edit="0">
                                    <field name="name"/>
                                    <field name="pin"/>
                                    <field name="status" widget="badge"
                                           decoration-info="status in ('pending','executed')"
                                           decoration-success="status=='success'"
                                           decoration-danger="status=='failed'"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="employee_id"/>
                                            <field name="pin"/>
                                            <field name="status"/>
                                        </group>
                                        <group>
                                            <field name="execution_log"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>


                        <page name="stamp_log" string="Stamp Log"
                              invisible="1">
                            <field name="stamp_log_ids">
                                <list string="Logs">
                                    <field name="name"/>
                                    <field name="log_date"/>
                                    <field name="log_text"/>
                                    <field name="device_id"
                                           column_invisible="True"/>
                                    <field name="stamp"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biometric_device_config_view_tree" model="ir.ui.view">
        <field name="name">biometric.config.list</field>
        <field name="model">biometric.config</field>
        <field name="arch" type="xml">
            <list string="Biometric Device">
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port"/>
                <field name="time_zone"/>
            </list>
        </field>
    </record>

    <record id="action_biometric_device_config_view" model="ir.actions.act_window">
        <field name="name">Biometric Device Config</field>
        <field name="res_model">biometric.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to config a new biometric device.
            </p>
        </field>
    </record>

    <record id="action_server_user_download" model="ir.actions.server">
        <field name="name">Download Users</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_biometric_config"/>
        <field name="binding_model_id" ref="model_biometric_config"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.download_device_users()</field>
    </record>

    <menuitem action="action_biometric_device_config_view"
              id="menu_biometric_device_config"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="98"
              groups="hr_attendance.group_hr_attendance_manager"/>

</odoo>
