<odoo>
    <!-- Search View -->
    <record id="view_face_template_search" model="ir.ui.view">
        <field name="name">face_template_search</field>
        <field name="model">face.template</field>
        <field name="arch" type="xml">
            <search string="Search Face Templates">
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <group>
                    <filter string="Device" name="device_face" context="{'group_by': 'device_id'}"/>
                    <filter string="Device User" name="device_face_user" context="{'group_by': 'device_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List (Tree) View -->
    <record id="view_face_template_tree" model="ir.ui.view">
        <field name="name">face.template.list</field>
        <field name="model">face.template</field>
        <field name="arch" type="xml">
            <list string="Face Templates" create="0">
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <field name="template_data" widget="binary"/>
                <field name="f_id"/>
                <field name="f_size"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_face_template_form" model="ir.ui.view">
        <field name="name">face.template.form</field>
        <field name="model">face.template</field>
        <field name="arch" type="xml">
            <form string="Face Template">
                <group>
                    <field name="employee_id"/>
                    <field name="device_id"/>
                    <field name="device_user_id"/>
                    <field name="template_data" widget="binary"/>
                    <field name="f_id"/>
                    <field name="f_size"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_face_template" model="ir.actions.act_window">
        <field name="name">Face Templates</field>
        <field name="res_model">face.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_face_template_search"/>
        <field name="context">{'search_default_device_face': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first face template
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_face_templates"
              name="Face Templates"
              parent="tis_hr_biometric_attendance.menu_biometric_device_config"
              action="action_face_template"
              sequence="50"/>
</odoo>
