<?xml version="1.0"?>
<odoo>
    <record id="account_move_cancel_reason" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- MIGRACIÓN V19: `attrs`/`states` reemplazados por
                 expresiones lógicas inline. `edi_state` vive en
                 `account_edi`, ahora declarado como dependencia explícita
                 (antes se simplificaba esta condición a solo el estado de
                 la factura porque el módulo no lo tenía disponible); se
                 restaura el `required=` real de Studio. También se ancla
                 dentro de `header_left_group` en vez de
                 antes/después de `payment_reference`: en 19.0 el core
                 reubicó ese campo a la columna derecha del header (en
                 15.0 vivía en la izquierda), así que este bloque
                 terminaba en la columna equivocada. -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="motivo_cancelacion"
                       required="edi_state == 'to_cancel'"/>
                <field name="fecha_confirmacion_cancelacion"
                       invisible="state != 'cancel'"/>
            </xpath>
        </field>
    </record>


    <record id="view_account_move_form_inherited_dates" model="ir.ui.view">
        <field name="name">account.move.form.inherited.dates</field>
        <field name="model">account.move</field>
        <!-- MIGRACIÓN V19: `l10n_mx_edi.view_l10n_mx_edi_invoice_form_inherit`
             ya no existe; la vista de l10n_mx_edi que hereda directamente de
             `account.view_move_form` ahora es
             `l10n_mx_edi.account_move_form_inherit_l10n_mx_edi`. -->
        <field name="inherit_id" ref="l10n_mx_edi.account_move_form_inherit_l10n_mx_edi"/>
        <!-- MIGRACIÓN V19: `active` explícito a propósito. Esta vista
             aparece archivada (`active=False`) en la base real sin causa
             rastreable en el código (ver `_reactivate_studio_views`,
             ahora eliminado). Reactivarla por separado vía SQL crudo ANTES
             de este `write()` (como hacía ese hook) abre una ventana
             donde queda activa con su `arch_db` viejo todavía sin corregir
             -rompe la validación de CUALQUIER vista hermana de
             `account.view_move_form` que se procese en esa ventana, con
             "Element ... cannot be located in parent view" apuntando al
             xpath viejo (`l10n_mx_edi_origin`)-. Declararlo aquí hace que
             reactivación y corrección de contenido sean el mismo `write()`
             atómico, sin ventana intermedia. -->
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <!-- MIGRACIÓN V19: `l10n_mx_edi_origin` -> `l10n_mx_edi_cfdi_origin`. -->
            <xpath expr="//field[@name='l10n_mx_edi_cfdi_origin']" position="after">
                <field name="fecha_entrega_mercancia_html" invisible="move_type != 'out_invoice'" readonly="1"/>
                <field name="fecha_recepcion_credito"/>
            </xpath>
            <xpath expr="//notebook/page[@name='other_info']" position="after">
                <page string="Movimientos de almacén" name="movimientos_almacen">
                    <field name="movimientos_almacen">
                        <list>
                            <field name="name" string="Movimiento" readonly="1"/>
                            <field name="origin" string="Origen" readonly="1"/>
                            <field name="location_id" string="Almacén" readonly="1"/>
                            <field name="date_done" readonly="1"/>
                            <field name="state" readonly="1" widget="badge" decoration-info="state in ('waiting','confirmed','assigned')" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
                            <field name="productos_entregados"/>
                        </list>
                    </field>
                    <label for="cantidad_facturada_total" string="Cantidad total facturada"/>
                    <field name="cantidad_facturada_total"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- MIGRACIÓN V19: el xmlid del modelo `account.move` es siempre
         `account.model_account_move` (el módulo que declara `_name`), nunca
         `<módulo>.model_account_move` para módulos que solo hacen
         `_inherit` -ese xmlid nunca existió-. -->
    <record id="action_cancel_invoices_03_04" model="ir.actions.server">
        <field name="name">Marcar como cancelada</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="code">action=model.mark_as_cancelled()</field>
        <field name="state">code</field>
    </record>
    <record id="action_duplicate_invoice" model="ir.actions.server">
        <field name="name">Duplicar (motivo 1)</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="code">action=model.duplicate_invoice()</field>
        <field name="state">code</field>
    </record>

    <record id="action_repair_invoice" model="ir.actions.server">
        <field name="name">Reparar esta factura</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="code">action=model.repair_invoice()</field>
        <field name="state">code</field>
    </record>

    <record id="invoice_search_inherit" model="ir.ui.view">
            <field name="name">invoice.search.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <search>
                    <field name="remision_name"/>
                </search>

            </field>
    </record>

</odoo>
