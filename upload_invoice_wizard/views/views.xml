<?xml version="1.0"?>
<odoo>
    <!-- MIGRACIÓN V19: se omite `sale_order_tree_inherit` -inheredaba
         `studio_customization.odoo_studio_sale_ord_...`, un id de una vista
         generada dinámicamente por Studio en la base de producción de v15,
         no exportable-. El mismo botón ya se agrega en las dos vistas reales
         de abajo (`sale.view_quotation_tree_with_onboarding` y
         `sale.view_order_tree`), que cubren los listados de cotizaciones y
         de órdenes de venta. -->

    <record id="sale_order_tree_upload_invoice" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button string="Subir factura externa" name="upload_invoice" type="object"/>
                </header>
            </list>
        </field>
    </record>

    <record id="sale_order_tree_upload_invoice_sale_tree" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button string="Subir factura externa" name="upload_invoice" type="object"/>
                </header>
            </list>
        </field>
    </record>

    <record id="purchase_order_tree_inherit_upload" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button string="Subir factura externa" name="upload_invoice" type="object"/>
                </header>
            </list>
        </field>
    </record>
</odoo>
