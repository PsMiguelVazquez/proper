<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_account_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited</field>
        <field name="model">account.move</field>
        <!-- MIGRACIÓN V19: `l10n_mx_edi.view_l10n_mx_edi_invoice_form_inherit`
             ya no existe; se reemplaza por
             `l10n_mx_edi.account_move_form_inherit_l10n_mx_edi`, la vista
             que hoy hereda directamente de `account.view_move_form` y
             añade tanto `l10n_mx_edi_usage` como el resto de campos MX. -->
        <field name="inherit_id" ref="l10n_mx_edi.account_move_form_inherit_l10n_mx_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_mx_edi_usage']" position="before">
                    <field name="codigo_uso_cfdi"/>
            </xpath>
            <!-- MIGRACIÓN V19: se ancla dentro de `header_left_group` en
                 vez de después de `partner_bank_id`: en 19.0 ese campo
                 vive en la columna derecha del header (`header_right_
                 group`), pero en 15.0 "Timbrado por"/"Versión CFDI"
                 aparecían en la columna izquierda junto a Cliente. -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="usuario_timbrado" readonly="1"/>
                <field name="version_cfdi" invisible="move_type != 'out_invoice'" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
