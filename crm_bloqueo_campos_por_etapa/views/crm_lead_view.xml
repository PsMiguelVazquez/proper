<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
    <record id="view_crm_lead_form" model="ir.ui.view">
        <field name="name">	crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <!-- MIGRACIÓN V19: el grupo `opportunity_info` ya no existe en
                 crm.crm_lead_view_form; el bloque de información de la
                 oportunidad equivalente ahora se llama `opportunity_partner`. -->
            <xpath expr="//group[@name='opportunity_partner']" position="after">
                <group name="info_adicional">
                    <field name="giro"/>
                    <field name="segmento"/>
                    <field name="temporalidad"/>
                    <field name="es_admin" invisible="1"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <!-- MIGRACIÓN V19: attrs="{'readonly': [('es_admin', '=', False)]}" -> expresión inline -->
                <attribute name="readonly">not es_admin</attribute>
            </xpath>

        </field>
    </record>
    </data>

</odoo>
