<?xml version="1.0"?>
<odoo>
        <record model="ir.ui.view" id="account_payment_register_form_compensate">
        <field name="name">account.payment.register.compensate</field>
        <field name="model">account.payment.register</field>
        <!-- Sin `priority`, esta vista y la vista core
             (`account.view_account_payment_register_form`, priority=16)
             empatan como vistas primarias del mismo modelo; Odoo desempata
             por nombre (`ir.ui.view._order = "priority,name,id"`), y
             "account.payment.register.compensate" ordena antes que
             "account.payment.register.form", así que esta vista terminaba
             ganando y siendo usada como vista POR DEFECTO del wizard -
             incluso para el botón "Pagar" genérico de la lista de
             facturas, que no pide una vista en particular
             (`account.move.line.action_register_payment`, `addons/account/
             models/account_move_line.py`). Como esta vista sólo muestra
             sus campos cuando `hide_button_payment_register == True` (sólo
             lo pone el flujo de compensación real, ver
             `view_compensate_wizard` en `models/account_move.py`), el
             resultado era un wizard vacío con un botón "Compensar" que
             fallaba al confirmarse sin datos. Se fija priority=99 (misma
             convención que usa Studio para sus vistas) para que nunca
             compita con la vista core; no afecta al flujo de compensación
             real, que siempre abre esta vista pasando su `view_id`
             explícito. -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <field name="hide_button_payment_register" invisible="1"/>
                <field name="financial_factor" invisible="1"/>
                <group invisible="hide_button_payment_register != True">
                    <group>
                        <field name="partner_id"/>
                         <field name="factor_bill" string="Gasto" domain="[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'),('payment_state', 'in', ('not_paid', 'partial'))]"/>
                        <field name="amount_factor_bill" string="Monto"/>
                        <field name="amount_residual_compensation"/>
                    </group>
                    <field name="partner_bills" domain="[('partner_id', '=', partner_id),
                                                                            ('move_type', '=', 'out_invoice')
                                                                            , ('state', '=', 'posted')
                                                                            ,('payment_state', 'in', ('not_paid', 'partial'))]">
                        <list create="0" delete="0" editable="bottom">
                            <field name="partner_id" optional="hide" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="amount_total_signed" string="Importe Total" readonly="1"/>
                            <field name="amount_residual" string="Importe adeudado" readonly="1" sum="Total adeudado"/>
                            <field name="balance_after_compensate" sum="Balance total adeudado"/>
                            <field name="porcent_assign" sum="Total por depósito" string="Monto por compensación"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Compensar" type="object" name="compensate" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
