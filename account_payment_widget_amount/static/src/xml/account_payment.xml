<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- MIGRACIÓN V19: reemplaza static/src/xml/account_payment.xml (t-name
         "PaymentAmountPopOver", cargado vía web.assets_qweb en 15.0). El
         popover "Add" ahora se abre desde el componente OWL
         account.AccountPaymentField; este template extiende el suyo
         (account.AccountPaymentField) para que el link "Add" abra primero
         este popover de monto en vez de asignar directamente. -->
    <t t-name="account_payment_widget_amount.AccountPaymentField"
       t-inherit="account.AccountPaymentField" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('outstanding_credit_assign')]" position="attributes">
            <attribute name="t-on-click.prevent">(ev) => this.onOutstandingCreditAssignClick(ev, info.moveId, line)</attribute>
        </xpath>
    </t>

    <t t-name="account_payment_widget_amount.PaymentAmountPopOver">
        <div class="js_payment_amount_div p-2">
            <div class="d-flex align-items-center mb-2">
                <strong class="me-2 text-nowrap">Paid Amount:</strong>
                <input type="number"
                       step="0.01"
                       class="o_input"
                       style="max-width: 8rem;"
                       t-model.number="state.amount"/>
            </div>
            <button class="btn btn-sm btn-primary js_payment_amount w-100"
                    t-on-click="onApplyClick">Apply</button>
        </div>
    </t>

</templates>
