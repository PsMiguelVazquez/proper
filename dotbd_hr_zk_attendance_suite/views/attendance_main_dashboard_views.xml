<?xml version="1.0" encoding="utf-8"?>
<!--
    Dot BD Solutions Limited
    Attendance Main Dashboard – Client Action + Menu

    v18 Odoo has a flat menu under menu_hr_attendance_root:
        Dashboard (ours, seq 1)  →  Overview (seq 5)  →  Management  →  Kiosk  →  …
    v19 Odoo nests "Overview" as a PARENT with children (Dashboard, Employees).
    We keep our custom Dashboard as a DIRECT CHILD of the root menu
    (same pattern as v18) so the landing-page sequence swap still works.
-->
<odoo>

    <!-- Client action that loads the OWL component -->
    <record id="action_attendance_main_dashboard" model="ir.actions.client">
        <field name="name">Biometric Attendance Insights</field>
        <field name="tag">attendance_main_dashboard</field>
    </record>

    <!-- Direct child of root (same level as Overview, Management, Kiosk …) -->
    <menuitem
        id="menu_attendance_main_dashboard"
        name="Dashboard"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_attendance_main_dashboard"
        sequence="1"/>

</odoo>
