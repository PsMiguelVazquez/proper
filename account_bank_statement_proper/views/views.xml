<odoo>
  <data>
      <!-- MIGRACIÓN V19: `account.view_bank_statement_form` ya no existe -
           el estado de cuenta bancario ahora se edita a través del widget
           de conciliación bancaria (Enterprise, account_accountant),
           basado en OWL. El formulario clásico equivalente para una línea
           de estado de cuenta es
           account_accountant.view_bank_statement_line_form_bank_rec_widget. -->
      <record model="ir.ui.view" id="account_bank_statement_line_form_inherit">
            <field name="name">account.bank.statement.line.form.inherit</field>
            <field name="model">account.bank.statement.line</field>
            <field name="inherit_id" ref="account_accountant.view_bank_statement_line_form_bank_rec_widget"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="rel_payment" options="{'no_create': True, 'no_create_edit':True}" domain="[('is_matched', '!=', True),('state','!=','cancel')]"/>
                    <field name="rel_invoices_names"/>
                </field>
            </field>
        </record>
  </data>
</odoo>
