<odoo>
    <data noupdate="1">
                          <record id="sequence_self_ruta" model="ir.sequence">
           <field name="name">seq_ruta</field>
           <field name="code">ruta</field>
            <field name="prefix">Expedición-</field>
           <field name="active">TRUE</field>
           <field name="padding">6</field>
           <field name="number_next">1</field>
           <field name="number_increment">1</field>
        </record>
    </data>

  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="automovil_list">
      <field name="name">automovil.list</field>
      <field name="model">automovil</field>
      <field name="arch" type="xml">
        <list string="Automovil">
            <field name="name"/>
            <field name="modelo"/>
            <field name="ano_modelo"/>
            <field name="fecha_adquisicion"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="automovil_form">
      <field name="name">automovil.form</field>
      <field name="model">automovil</field>
      <field name="arch" type="xml">
        <form>
              <sheet>
        <header></header>
        <div class="oe_button_box" name="button_box">
            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
            </button>
        </div>
        <field name="imagen" widget="image" class="oe_avatar"/>
        <div class="oe_title">
            <label for="modelo" class="oe_edit_only"/>
            <h1>
                <field name="modelo" placeholder="e.g. Model S"/>
            </h1>
            <label for="license_plate" class="oe_edit_only"/>
            <h2>
                <field name="license_plate" class="oe_inline" placeholder="e.g. PAE 326"/>
            </h2>
        </div>
        <group>
            <group>
                <field name="driver_id"/>
                <field name="ubicacion"/>
                <field name="vin_sn"/>
                <field name="ano_modelo"/>
                <field name="compania" groups="base.group_multi_company"/>
            </group>
            <group>
                <label for="odometro"/>
                <div class="o_row">
                    <field name="odometro"/>
                    <field name="unidad_odometro"/>
                </div>
                <field name="fecha_adquisicion"/>
                <field name="valor_auto"/>
            </group>
        </group>
        <group>
            <group string="Additional Properties">
                <field name="asientos"/>
                <field name="puertas"/>
                <field name="color"/>
            </group>
            <group string="Engine Options">
                <field name="transmision"/>
                <field name="fuel_type"/>
                <field name="caballos"/>
            </group>
        </group>
    </sheet>
    <!-- MIGRACIÓN V19: los <div class="oe_chatter"> con widgets
         mail_followers/mail_thread se reemplazan por el elemento moderno
         <chatter/> (ver p.ej. addons/sale/views/sale_order_views.xml). -->
    <chatter/>
        </form>
      </field>
    </record>
    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="automovil_action_window">
      <field name="name">automovil</field>
      <field name="res_model">automovil</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="creacion_ruta_list">
      <field name="name">creacion.ruta.list</field>
      <field name="model">creacion.ruta</field>
      <field name="arch" type="xml">
          <list string="creacion.ruta" delete="false">
              <field name="id" />
              <field name="create_date" />
              <field name="name"/>
              <field name="tipo"/>
              <field name="chofer"/>
              <field name="vehiculo"/>
              <field name="zona"/>
              <field name="create_uid"/>
              <field name="EstadoPais"/>
          </list>
      </field>
    </record>

    <record model="ir.ui.view" id="ruta_form">
      <field name="name">creacion.ruta.form</field>
      <field name="model">creacion.ruta</field>
      <field name="arch" type="xml">
      <form>
          <header>
              <button name="confirmar" type="object" string="Confirmar" invisible="estado == 'valido'"></button>
              <field name="estado" widget="statusbar"></field>
          </header>
          <sheet string="creacion.ruta">
              <h2>
                  <field name="name" invisible="not id"/>
              </h2>
              <group>
                  <group>
                      <field name="chofer"  required="1"/>
                      <field name="vehiculo" required="1"/>
                      <field name="tipo" required="1"/>
                  </group>
                  <group>
                      <field name="zona"  required="1"/>
                      <field name="odometro"  string="Odometro" required="1"/>
                      <field name="nivel_tanque"  string="Nivel del tanque" required="1"/>
                  </group>
              </group>
              <field name="ordenes" domain="['&amp;', ['picking_type_id.code','=','outgoing'], ['state','=','assigned']]">
                  <list string="Picking list" editable="bottom">
                      <field name="id" column_invisible="1"/>
                      <field name="ruta_id" column_invisible="1"/>
                      <field name="name" column_invisible="1"/>
                      <field name="origin" readonly="1" string="Orden"/>
                      <field name="carrier_tracking_ref" />
                      <field name="guia" string="Guia de ventas" readonly="1"/>
                      <field name="evidencia" force_save="1" />
                      <!-- MIGRACIÓN V19: `show_validate` ya no existe en
                           stock.picking; la visibilidad moderna del botón
                           Validate se basa solo en `state` (ver
                           addons/stock/views/stock_picking_views.xml). -->
                      <button name="button_validate" invisible="state in ('draft', 'confirmed', 'done', 'cancel')" string="Validate" type="object" class="oe_highlight" groups="stock.group_stock_user"/>
                      <button name="button_validate" invisible="state in ('waiting', 'assigned', 'done', 'cancel')" string="Validate" type="object" groups="stock.group_stock_user" class="o_btn_validate"/>
                      <field name="state" column_invisible="1"/>
                  </list>
              </field>
          </sheet>
      </form>
      </field>
    </record>
    <record model="ir.actions.act_window" id="creacion_ruta_action_window">
      <field name="name">ruta</field>
      <field name="res_model">creacion.ruta</field>
      <field name="view_mode">list,form</field>
    </record>
    <menuitem name="Distribucion" id="distribucion_menu" parent="stock.menu_stock_root" sequence="5"/>
    <menuitem name="Vehiculos" id="vehiculos_menu" parent="distribucion_menu" action="fleet.fleet_vehicle_action" />
    <menuitem name="Ruta" id="ruta_menu" parent="vehiculos.distribucion_menu" action="creacion_ruta_action_window" />

    <!-- MIGRACIÓN V19: se elimina `view_account_payment_form_update` -el
         modelo `stock.immediate.transfer` que heredaba (y su vista
         `stock.view_immediate_transfer`) ya no existen: Odoo simplificó el
         flujo, ya no hay un wizard aparte de "transferencia inmediata"
         (ver models/models.py, clase StockPickingLL eliminada por el mismo
         motivo). Los campos `evidencia`/`code` de ese wizard nunca se
         sincronizaban con `stock.picking.evidencia` (definido en
         models/ruta.py) de todas formas: ya era funcionalidad muerta en
         15.0. -->

        <record id="sale_orde_proposal_requirement" model="ir.ui.view">
        <field name="name">sale.order.form.vehiculos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='payment_term_id']" position="after">
            <field name="guia" string="Guia de ventas"/>
            <field name="carrier_tracking_ref" invisible="not carrier_tracking_ref" readonly="1"/>
        </xpath>
        </field>
        </record>

      <!-- MIGRACIÓN V19: se elimina `stock_alm_0_14_form` (duplicaba
           íntegramente el formulario estándar de stock.picking de 15.0, sin
           ninguna personalización propia visible, y usaba campos que ya no
           existen: `immediate_transfer`, `quantity_done`,
           `move_line_nosuggest_ids`, `show_validate`, etc.). Al no aportar
           ninguna customización real, se usa directamente el formulario
           estándar `stock.view_picking_form` de 19.0 para esta acción, en
           vez de mantener una copia duplicada y frágil. -->
      <record model="ir.actions.act_window" id="action_alm0_alm14">
          <field name="name">Solicitudes ALM14-ALM0</field>
          <field name="res_model">stock.picking</field>
          <field name="view_mode">list,form</field>
          <field name="context">{'contact_display': 'partner_address', 'default_company_id': allowed_company_ids[0]}</field>
          <field name="domain">['&amp;', ['location_id', 'ilike', 'ALM14'], ['location_dest_id', 'ilike', 'ALM-0']]</field>
          <field name="view_ids" eval="[(5, 0, 0),
                (0,0, {'view_mode': 'list', 'view_id': ref('stock.vpicktree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
      </record>
      <menuitem id="menu_item_actio_alm_0_14" action="action_alm0_alm14"  parent="stock.menu_stock_warehouse_mgmt"/>

  </data>
</odoo>
