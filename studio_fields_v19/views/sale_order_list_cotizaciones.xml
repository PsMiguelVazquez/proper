<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        MIGRACIÓN V19: formaliza la personalización de Odoo Studio del menú
        "Contabilidad/Ventas/Cotizaciones por aprobar". La acción
        (`studio_customization.cotizaciones_por_apr...`) usaba el campo
        `view_id` (no la tabla de vistas múltiples) para apuntar
        directamente a una vista de lista de Studio sin xmlid -se pierde en
        cada rebuild de Odoo.sh-. Esa vista no tenía ninguna personalización
        adicional encima (a diferencia de "Pedidos de ventas"/"Marketplace"):
        son los campos base de `sale.order` más `x_utilidad_total_por`
        (ya formalizado). Se escribe como vista de lista completa y se
        referencia explícitamente desde la acción.
    -->
    <record id="sale_order_list_cotizaciones" model="ir.ui.view">
        <field name="name">sale.order.list.cotizaciones</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Quotation" class="o_sale_order" sample="1">
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="create_date" string="Creation Date" widget="date" optional="show"/>
                <field name="commitment_date" widget="date" optional="hide"/>
                <field name="expected_date" widget="date" optional="hide"/>
                <field name="partner_id" readonly="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="tag_ids" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="company_id" groups="base.group_multi_company" optional="show" readonly="1"/>
                <field name="amount_untaxed" sum="Total Tax Excluded" widget="monetary" optional="hide"/>
                <field name="amount_tax" sum="Tax Total" widget="monetary" optional="hide"/>
                <field name="x_utilidad_total_por"/>
                <field name="amount_total" sum="Total Tax Included" widget="monetary" decoration-bf="1" optional="show"/>
                <field name="state" decoration-success="state == 'sale' or state == 'done'"
                       decoration-info="state == 'draft' or state == 'sent'" widget="badge" optional="show"/>
                <field name="invoice_status" optional="hide"/>
                <field name="message_needaction" invisible="1"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_order_action_cotizaciones" model="ir.actions.act_window">
        <field name="name">Cotizaciones por aprobar</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="view_id" ref="sale_order_list_cotizaciones"/>
        <field name="domain">[('state', '=', 'credito_conf')]</field>
    </record>
</odoo>
