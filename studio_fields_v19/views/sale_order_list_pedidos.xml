<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        MIGRACIÓN V19: formaliza la personalización de Odoo Studio del menú
        "Contabilidad/Ventas/Pedidos de ventas" (`studio_customization.
        pedidos_de_ventas...`, con `view_id` directo -no la tabla de vistas
        múltiples- a una vista de lista de Studio sin xmlid, más una
        extensión mínima que sólo le pone widget `many2many_tags` a
        `invoice_ids`). Se combinan ambas en una sola vista de lista
        completa, referenciada explícitamente desde la acción.
    -->
    <record id="sale_order_list_pedidos" model="ir.ui.view">
        <field name="name">sale.order.list.pedidos</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Quotation" class="o_sale_order" multi_edit="1" sample="1" create="0">
                <field name="x_studio_n_orden_de_compra" string="Orden de Compra" optional="show"/>
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="create_date" string="Creation Date" widget="date" optional="show"/>
                <field name="commitment_date" widget="date" optional="hide"/>
                <field name="expected_date" widget="date" optional="hide"/>
                <field name="partner_id" readonly="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="tag_ids" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="company_id" groups="base.group_multi_company" optional="show" readonly="1"/>
                <field name="amount_untaxed" sum="Total Tax Excluded" widget="monetary" optional="hide"/>
                <field name="amount_tax" sum="Tax Total" widget="monetary" optional="hide"/>
                <field name="amount_total" sum="Total Tax Included" widget="monetary" decoration-bf="1" optional="show"/>
                <field name="state" decoration-success="state == 'sale' or state == 'done'"
                       decoration-info="state == 'draft' or state == 'sent'" widget="badge" optional="show"/>
                <field name="invoice_status" optional="hide"/>
                <field name="message_needaction" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="invoice_ids" string="Facturas relacionadas" optional="show" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="sale_order_action_pedidos" model="ir.actions.act_window">
        <field name="name">Pedidos de ventas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,calendar,pivot,graph,activity</field>
        <field name="view_id" ref="sale_order_list_pedidos"/>
    </record>
</odoo>
