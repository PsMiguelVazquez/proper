<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        MIGRACIÓN V19: formaliza la personalización de Odoo Studio sobre
        `crm.crm_lead_view_form`. Antes vivía sólo como `ir.ui.view`
        state=manual, se perdía en cada rebuild de Odoo.sh.

        Cambios de v15 -> v19 aplicados aquí (no en la vista original):
        - `attrs="{...}"` -> atributos directos (`invisible=`).
        - El primer xpath original metía un `<field>` dentro de un
          `position="attributes"` (Odoo ignora nodos que no sean
          `<attribute>` ahí, así que en v15 tampoco tenía efecto real); se
          quita, y el campo (`x_probabilidad_lead`) ya se agrega, visible
          condicionalmente, en el xpath de `lead_partner` de más abajo.
        - `x_studio_descripcin_de_segmento` seguía comentado en el
          original -Studio ya lo había desactivado-, no se porta.
        - En la lista embebida de `x_producto_almacen`, el campo `price`
          (precio contextual por lista de precios) ya no existe en
          `product.product`; se quita esa columna, siempre estaba oculta
          de todas formas (`invisible` cuando no había `pricelist` en el
          contexto, algo que esta vista nunca setea).
        - `type == 'product'` (indicaba "almacenable" en v15) ya no es un
          valor válido: `type` ahora es sólo consu/service/combo y lo
          "almacenable" se decide con el booleano `is_storable`.
    -->
    <record id="crm_lead_form_customization" model="ir.ui.view">
        <field name="name">crm.lead.form.customization</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='probability']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="before">
                    <field name="x_fecha"/>
                </xpath>
                <xpath expr="//group[@name='lead_partner']" position="after">
                    <field name="x_probabilidad_lead" invisible="type == 'opportunity'"/>
                    <field name="x_probabilidad_etapa" invisible="type == 'lead'"/>
                </xpath>
                <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="before">
                    <field name="x_studio_probabilidad_venta" string="Probabilidad venta" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                    <field name="x_studio_related_field_KECm2" string="Nivel de cliente"/>
                    <field name="x_producto_almacen">
                        <list string="Product Variants" multi_edit="1" duplicate="false" sample="1" create="false">
                            <field name="default_code" optional="show" readonly="1" string="Modelo"/>
                            <field name="x_studio_many2one_field_AqNlU" invisible="1"/>
                            <field name="barcode" optional="hide" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="description_sale"/>
                            <field name="description_purchase" invisible="1"/>
                            <field name="website_id" groups="website.group_multi_website" optional="show" invisible="1"/>
                            <field name="is_published" string="Is Published" optional="hide"/>
                            <field name="product_template_attribute_value_ids" widget="many2many_tags"
                                   groups="product.group_product_variant" readonly="1" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
                            <field name="lst_price" optional="show" string="Sales Price"/>
                            <field name="standard_price" optional="show" invisible="1"/>
                            <field name="categ_id" optional="hide"/>
                            <field name="type" optional="hide" readonly="1"/>
                            <field name="qty_available" invisible="not is_storable" optional="show"
                                   decoration-danger="virtual_available &lt; 0" decoration-warning="virtual_available == 0"
                                   decoration-bf="1"/>
                            <field name="virtual_available" invisible="not is_storable" string="Forecasted Quantity"
                                   optional="show" decoration-danger="virtual_available &lt; 0"
                                   decoration-warning="virtual_available == 0"/>
                            <field name="uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"
                                   optional="show" readonly="1" invisible="1"/>
                            <field name="product_tmpl_id" invisible="1" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </list>
                    </field>
                </xpath>
                <xpath expr="//group[@name='categorization']" position="attributes">
                    <attribute name="string">Origen</attribute>
                </xpath>
                <xpath expr="//page[@name='extra']//group[@name='categorization']/field[@name='source_id']"
                       position="attributes">
                    <attribute name="string">Digital</attribute>
                </xpath>
                <xpath expr="//page[@name='extra']//group[@name='categorization']/field[@name='referred']"
                       position="after">
                    <field name="x_studio_relacin_de_vendedor" string="Relación de vendedor"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
