<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="sale_order_form_block_edit" model="ir.ui.view">
        <field name="name">sale.order.form.block.edit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- MIGRACIÓN V19: `field[@name='authorized_transaction_ids']`
                 ya no existe como tal en el header (el core usa solo el
                 booleano calculado `has_authorized_transaction_ids`); se
                 usa el botón "Create Invoice" (`id="create_invoice"`) como
                 ancla estable en su lugar. -->
            <xpath expr="//form/header/button[@id='create_invoice']" position="before">
                <field name="edit_blocked" invisible="1"/>
                <field name="block_invoicing" invisible="1"/>
                <field name="invoice_approved" invisible="1"/>
                <field name="approve_invoicing_requested" invisible="1"/>
            </xpath>
            <!-- MIGRACIÓN V19: `button[@name='328']` era el ID numérico
                 (resuelto en esa base de datos específica) de la acción
                 `sale.action_view_sale_advance_payment_inv` -el botón
                 "Create Invoice" del core-, no una acción de Studio. Se
                 referencia por su `id` estable en vez del número; `attrs`
                 -> `invisible` inline. -->
            <xpath expr="//form/header/button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or block_invoicing</attribute>
            </xpath>
            <header>
                <button name="approve_invoicing" string="Aprobar facturación" type="object"
                        invisible="approve_invoicing_requested != True"/>
                <button name="request_approve_invoicing" string="Solicitar Aprobación de facturación" type="object"
                        invisible="state != 'sale' or block_invoicing != True or approve_invoicing_requested == True"/>
            </header>
            <xpath expr="//form/sheet/notebook/page/field[@name='order_line']" position="attributes">
                <attribute name="readonly">edit_blocked == True</attribute>
            </xpath>
        </field>
    </record>

</odoo>
