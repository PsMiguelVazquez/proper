<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_reference']" position="before">
                    <field name="x_estado_actuali_cli" invisible="1"/>
                </xpath>
                <!-- MIGRACIÓN V19: `string` no puede usarse como selector en
                     herencia de vistas; se usa el índice posicional entre
                     los botones `action_post` -el segundo es "Confirm",
                     visible cuando `move_type != 'entry'`, ver vista base
                     `account.view_move_form`-.
                     `auto_post` era `Boolean` en 15.0; en 19.0 el core lo
                     rediseñó como `Selection` (`no`/`at_date`/`monthly`/...,
                     `default='no'`, ver `account/models/account_move.py`).
                     Comparar el campo "a pelo" (`auto_post`, pensado para un
                     booleano) ahora siempre es verdadero -`'no'` es un
                     string no vacío, y por lo tanto "truthy"-, así que el
                     botón quedaba oculto casi siempre. Se compara contra
                     `'no'` explícitamente para recuperar la intención
                     original: ocultarlo sólo cuando SÍ está configurado
                     para autopublicarse. -->
                <xpath expr="//button[@name='action_post'][2]" position="replace">
                    <button name="action_post" string="Confirm" class="oe_highlight"
                                type="object" groups="account.group_account_invoice" data-hotkey="v"
                                invisible="x_estado_actuali_cli == '3.3' or state != 'draft' or auto_post != 'no' or move_type == 'entry' or display_inactive_currency_warning"></button>
                </xpath>
                <header>
                </header>
            </field>
        </record>

        <record id="account_invoice_filter_inherit" model="ir.ui.view">
            <field name="name">account.move.filter.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='due_date']" position="after">
                    <filter name="invoice_datetime_date" string="Fecha de timbrado" date="invoice_datetime_date"/>
                </xpath>
            </field>
        </record>
        <record id="res_partner_view_search_inherit" model="ir.ui.view">
            <field name="name">res.partner.view.search.inherited</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="x_grupo_cliente"/>
                </xpath>
                <xpath expr="//filter[@name='salesperson']" position="before">
                    <filter name="x_grupo_cliente" string="Grupo" context="{'group_by': 'x_grupo_cliente'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
