<odoo>
    <data>
        <record id="sale_order_alerta_view" model="ir.ui.view">
        <field name="model">sale.order.alerta</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <field name="mensaje" readonly='1'/>
                <footer>
                    <button string="Confirmar" name="confirmar_sale" type="object" class="btn-primary" />
                    <button special="cancel" string="Cerrar"  class="btn-secondary" />
                </footer>
            </form>
        </field>

        </record>

        <record id="sale_order_validar_view" model="ir.ui.view">
            <field name="model">sale.order.alerta</field>
            <field name="arch" type="xml">
                <form string="Alerta">
                    <field name="mensaje" readonly='1'/>
                    <footer>
                        <button string="Confirmar" name="confirmar_validacion" type="object" class="btn-primary" />
                        <button special="cancel" string="Cerrar"  class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="sale_order_partial_view" model="ir.ui.view">
            <field name="model">sale.order.alerta</field>
            <field name="arch" type="xml">
                <form string="Alerta">
                    <field name="mensaje" readonly='1'/>
                    <field name="sale_id" invisible="1" readonly='1'/>
                    <field name="line_ids" class="oe_edit_only"  options="{'no_create': True}"
                       widget="many2many"
                       domain="[('order_id', '=', sale_id)]"
                    >
                        <list create="false" delete="false" editable="top">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty"  readonly="1"/>
                            <field name="price_unit"  readonly="1"/>
                            <field name="x_cantidad_disponible_compra"  string="Cantidad propuesta por compras" readonly="1"/>
                            <field name="cantidad_faltante" readonly="1"/>
                            <field name="cantidad_a_comprar" />
                            <field name="atendido_por"  readonly="1"/>
                        </list>
                    </field>
                    <field name="mensaje_bottom" readonly='1'/>

                    <footer>
                        <button string="Confirmar" name="confirmar_parcial" type="object" class="btn-primary" />
                        <button special="cancel" string="Cerrar"  class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="sale_order_invoice_conf_view" model="ir.ui.view">
        <field name="model">sale.orders.invoice</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <field name="name" invisible="1"/>
                <field name="sale_ids" invisible="1" force_save="1"/>
                <field name="order_lines_ids" force_save="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="order_id"/>
                        <field name="product_id" readonly="1"/>
                        <field name="qty" readonly="1"/>
                        <field name="cantidad_asignada" readonly="1"/>
                        <field name="cantidad_entregada" readonly="1"/>
                        <field name="qty_sale_invoice" readonly="1"/>
                        <field name="qty_invoice"/>
                        <field name="check" />
                    </list>
                </field>
                <footer>
                    <button string="Confirmar" name="confir" type="object" class="btn-primary" />
                    <button special="cancel" string="Cerrar"  class="btn-secondary" />
                </footer>
            </form>
        </field>
        </record>

        <record id="purchase_order_invoice_conf_view" model="ir.ui.view">
        <field name="model">purchase.wizard.conf</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <h2>Se validarán las ordenes seleccionadas.</h2>
                <footer>
                    <button string="Confirmar" name="confirm" type="object" class="btn-primary" />
                    <button special="cancel" string="Cerrar"  class="btn-secondary" />
                </footer>
            </form>
        </field>
        </record>

        <record id="purchase_order_merge_conf_view" model="ir.ui.view">
        <field name="model">purchase.wizard.merge</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <h2>Se mezclaran la ordenes seleccionadas</h2>
                <footer>
                    <button string="Confirmar" name="confirm" type="object" class="btn-primary" />
                    <button special="cancel" string="Cerrar"  class="btn-secondary" />
                </footer>
            </form>
        </field>
        </record>
                <record id="sale_orde_proposal_requirement" model="ir.ui.view">
                    <field name="model">sale.order</field>
                    <field name="inherit_id" ref="sale.view_order_form"/>
                    <field name="arch" type="xml">
                        <xpath expr="//sheet/div[1]" position="after">
                            <field name="es_orden_parcial" invisible="1"/>
                            <widget name="web_ribbon" bg_color="bg-danger" title="Asignado parcialmente" invisible="not es_orden_parcial"/>
                        </xpath>
                        <xpath expr="//field[@name='order_line']/list" position="inside">
                            <field name="x_utilidad_por" column_invisible="True"/>
                            <field name="utilidad_esperada" column_invisible="True"/>
                        </xpath>
                        <xpath expr="//field[@name='order_line']/list" position="attributes">
                            <attribute name="decoration-danger">x_utilidad_por &lt; utilidad_esperada</attribute>
                        </xpath>
                        <xpath expr="//field[@name='payment_term_id']" position="after">
                            <field name="albaran" invisible="not albaran"/>
                            <field name="partner_loc_ids" invisible="1"/>
                        </xpath>
                        <xpath expr="//field[@name='partner_shipping_id']" position="after">
                            <label for="partner_id_payment_method"/>
                            <div>
                                <field name="partner_id_payment_method_code" class="oe_inline"/>
                                -
                                <field name="partner_id_payment_method" class="oe_inline"/>
                            </div>
                        </xpath>
                        <xpath expr="//field[@name='partner_shipping_id']" position="after">
                            <field name="partner_id_uso_cfdi" string="Uso de CFDI" readonly="1"/>
                        </xpath>
                    <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                        <page string="Requerimientos" name="studio_page_0ru5U">
                            <field name="requirements_line_ids">
                                <list string="Solicitud de requerimiento del cliente" editable="bottom">
                                    <field name="x_name" force_save="True" readonly="1" string="Nom. Requerimiento"/>
                                    <field name="x_descripcion" optional="show" required="1"/>
                                    <field name="x_marca" optional="show"/>
                                    <field name="x_modelo" optional="show"/>
                                    <field name="x_cantidad" optional="show" string="Cantidad"/>
                                    <field name="x_precio_uni" optional="show"/>
                                    <field name="x_presupuesto" optional="show" string="Presupuesto"/>
                                    <field name="x_proveedor" optional="show" string="Proveedor"/>
                                    <field name="x_link_sitio" optional="hide"/>
                                    <field name="x_comprar" optional="show"/>
                                    <field name="x_count" optional="show" column_invisible="True"/>
                                    <field name="x_studio_estado" string="estado" column_invisible="True"/>
                                    <button name="cancel" string="Cancelar" type="object" class="btn-primary" invisible="x_studio_estado == 'cancel'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Propuestas" name="studio_page_qwbde">
                            <field name="proposal_line_ids">
                                <list string="Propuesta de Compras" decoration-success="x_state == 'done'" decoration-warning="x_state == 'confirmado'">
                                    <field name="x_name" string="Propuesta"/>
                                    <field name="x_descripcion" optional="show"/>
                                    <field name="x_cantidad" optional="show" string="Cantidad"/>
                                    <field name="x_costo" optional="show" string="Costo"/>
                                    <field optional="show" name="x_studio_proveedor" string="Proveedor"/>
                                    <field name="x_state" optional="show" column_invisible="True" string="Estado"/>
                                    <field name="x_proveedor" optional="show"  />
                                    <field name="x_note" optional="hide"></field>
                                    <field name="x_new_prod_prop" default="True" column_invisible="True"/>
                                    <button name="confirm" string="Confirmar" type="object" class="btn-primary" invisible="x_state not in ('draft','atendido')"/>
                                    <button name="cancel" string="Cancelar" type="object" class="btn-primary" />
                                    <button name="validar" string="Re-validar" type="object" class="btn-primary"/>
                                    <button name="autoriz" string="Compra autorizada" type="object" class="btn-primary"/>
                                </list>
                            </field>
                        </page>
                    </xpath>
        </field>
                </record>


        <record id="stock_stock_product_search_form_view_inherit" model="ir.ui.view">
                    <field name="model">product.product</field>
                    <field name="inherit_id" ref="stock.view_stock_product_tree"/>
                    <field name="arch" type="xml">
                        <xpath expr="//field[@name='virtual_available']" position="after">
                            <field name="stock_quant_warehouse_zero"/>
                        </xpath>
                    </field>
                </record>




        <record id="sale_stock_view_order_form_inherith_available_qty" model="ir.ui.view">
            <field name="name">sale.order.line.tree.sale.stock.qty</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="numero_ordenes_compra_activas"  invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ('draft', 'sent', 'sale') or not id or numero_ordenes_compra_activas &gt; 0</attribute>
                </xpath>
                <xpath expr="//page/field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                    <field name="existencia_alm_0" column_invisible="True"/>
                    <field name="existencia_html" string=" "  widget="html" readonly="1"/>
                </xpath>
                <xpath expr="//page/field[@name='order_line']/list/field[@name='qty_delivered']" position="before">
                    <field name="cantidad_asignada" decoration-success="cantidad_asignada==product_uom_qty" decoration-danger="state=='sale' and cantidad_asignada&lt;product_uom_qty"/>
                </xpath>
                <!-- MIGRACIÓN V19: `sale.view_order_line_tree` (vista standalone
                     de sale.order.line) ya no existe en 19.0; su único uso en
                     este módulo (agregar `x_solicitud_atendida` y una
                     decoración) se traslada aquí, directamente sobre el
                     sub-list del campo `order_line` en el formulario. -->
                <xpath expr="//page/field[@name='order_line']/list" position="inside">
                    <field name="x_solicitud_atendida" column_invisible="True"/>
                </xpath>
                <xpath expr="//page/field[@name='order_line']/list" position="attributes">
                    <attribute name="decoration-primary">x_solicitud_atendida=='Atendido'</attribute>
                </xpath>
            </field>
        </record>


        <record id="action_solicitar_cancelacion_pedido" model="ir.actions.server">
            <field name="name">Solicitar cancelación de pedido</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">record['state'] = 'purchase_conf'</field>
        </record>

        <record id="action_aceptar_cancelacion_compra" model="ir.actions.server">
            <field name="name">Aceptar cancelación compra</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">
record.action_cancel()
record['x_acep_cancel_compra'] = True
            </field>
        </record>

        <record id="action_rechazar_cancelacion_pedido" model="ir.actions.server">
            <field name="name">Rechazar cancelación de pedido</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">
record.action_confirm()
record['x_acep_cancel_compra'] = False
            </field>
        </record>

        <record id="sale_order_form_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.inherited</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <header>
                    <button string="Validar datos masivamente" name="validar_precio_masivo" type="object" invisible="state not in ('draft','send')"/>
                </header>
                <xpath expr="//field[@name='partner_invoice_id']" position="before">
                    <field name="sales_agent" string="Vendedor asocialdo al cliente"/>
                </xpath>
                <!-- MIGRACIÓN V19: estos 3 botones eran de Odoo Studio,
                     referenciando por ID numérico crudo (`name="1320"`,
                     etc.) a 3 `ir.actions.server` que tampoco tenían xmlid
                     propio -en una instalación limpia ese ID no existe y el
                     botón falla con "Action N does not exist for button of
                     type action"-. Se formalizan arriba las 3 acciones y se
                     referencian aquí con xmlid estable. El xpath original
                     de Studio usaba `position="replace"` sobre
                     `//button[@name='action_quotation_send']`, pero ese
                     `name` ya no es único en 19.0 (el core tiene 4 botones
                     distintos con ese mismo `name`, uno por cada
                     combinación de estado/grupo) y borrar cualquiera de
                     ellos del árbol rompe la fusión del `<header>` con
                     otros módulos que también lo extienden (p. ej.
                     `block_edit_sale_order`, que agrega botones propios al
                     `<header>` y espera que ninguno de los botones
                     originales del core haya desaparecido). Se logra el
                     mismo resultado visual sin borrar nada: se agregan los
                     3 botones nuevos después del botón "Send" que aplica a
                     'sent'/'sale' (`id="quotation_send"`), y se oculta ese
                     botón original en los mismos casos en que estos 3
                     aplicarían. -->
                <xpath expr="//button[@id='quotation_send']" position="attributes">
                    <attribute name="invisible">(state not in ('sent', 'sale')) or numero_ordenes_compra_activas != 0</attribute>
                </xpath>
                <xpath expr="//button[@id='quotation_send']" position="after">
                    <button name="%(action_solicitar_cancelacion_pedido)d" string="Solicitar Cancelación" class="btn-primary" type="action" invisible="numero_ordenes_compra_activas == 0 or state not in ['sale']" groups="sales_team.group_sale_manager,sales_team.group_sale_salesman"/>
                    <button name="%(action_aceptar_cancelacion_compra)d" string="Aceptar Cancelación" class="btn-primary" type="action" invisible="numero_ordenes_compra_activas == 0 or state not in ['purchase_conf']" groups="sale_purchase_confirm.group_aprobacion_compras"/>
                    <button name="%(action_rechazar_cancelacion_pedido)d" string="Rechazar Cancelación" class="btn-primary" type="action" invisible="numero_ordenes_compra_activas == 0 or state not in ['purchase_conf']" groups="sale_purchase_confirm.group_aprobacion_compras"/>
                </xpath>
            </field>
        </record>

        <!-- MIGRACIÓN V19: la vista `l10n_mx_edi.mx_partner_address_form` fue
             eliminada/rediseñada en el módulo Enterprise `l10n_mx_edi` de
             19.0 (ya no existe ese id); esta personalización del formato de
             dirección (estado/ciudad de México) queda absorbida por el
             formulario de dirección estándar de 19.0 y se omite. -->

    <record id="action_facturar" model="ir.actions.server">
        <field name="name">Facturar</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="sale_purchase_confirm.model_sale_orders_invoice"/>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="code">action=model.get_filtered_record()</field>
        <field name="state">code</field>
    </record>

        <record id="action_purchase_valid" model="ir.actions.act_window">
        <field name="name">Validación</field>
        <field name="res_model">purchase.wizard.conf</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
    </record>

        <record id="action_purchase_merge" model="ir.actions.act_window">
        <field name="name">Mezcla</field>
        <field name="res_model">purchase.wizard.merge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
    </record>

    <record id="view_account_move_reversal_inherit" model="ir.ui.view">
        <field name="name">account.move.reversal.inherited</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="replace">
                <field name="motivo"/>
                <field name="reason" invisible="motivo != 'otros'"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="uso_cfdi"/>
                <field name="tipo_relacion"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_nota_credito" model="ir.ui.view">
        <field name="name">account.move.nota</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="tipo_nota" invisible="move_type != 'out_refund'"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="wizard_puchase_create_form">
        <field name="model">wizard.purchase.create</field>
        <field name="name"></field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="proposal_ids" invisible="1"/>
                        <field name="partner_id" required="1" string="Proveedor" domain="[('supplier_rank', '=', 1)]"/>
                    </group>
                </sheet>
                <footer>
                    <button type="object" name="confirm" string="Crear Orden" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_create_propo" model="ir.actions.act_window">
        <field name="name">Crear Orden</field>
        <field name="res_model">wizard.purchase.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="binding_model_id" ref="model_proposal_purchases" />
    </record>
  </data>
</odoo>
