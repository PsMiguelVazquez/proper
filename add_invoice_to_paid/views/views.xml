<odoo>
  <data>

    <record model="ir.ui.view" id="add_invoice_to_paid_list">
      <field name="name">add_invoice_to_paid list</field>
      <field name="model">account.payment.wizard.ex</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
            <field name="payment" invisible="1"/>
            <field name="partner_id" invisible="1"/>
            <field name="amount_rest" string="Monto Restante"/>
            <field name="amount_applied" string="Monto aplicado"/>
            <field name="invoices_ids" widget="many2many" domain="['|','&amp;',('partner_id', '=', partner_id),'&amp;', ('move_type', '=', 'out_invoice'), '&amp;',('payment_state', 'in', ('not_paid', 'partial')), ('state', '=', 'posted'),
                                                                    '&amp;',('partner_id', '=', partner_id), '&amp;',('state', '=', 'posted'), '&amp;',('payment_state', 'in', ('not_paid','partial')), ('name', 'ilike', 'END/')]">
              <list editable="bottom">
                <field name="name" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="ref" readonly="1"/>
                <field name="amount_residual_signed" readonly="1"/>
                <field name="amount_total" readonly="1"/>
                <field name="porcent_assign"/>
              </list>
            </field>
            </group>
          </sheet>
          <footer>
            <button name="done" type="object" string="Confirmar"/>
          </footer>
        </form>
      </field>
    </record>

        <record model="ir.ui.view" id="add_invoice_to_paid_inherit">
          <field name="name">add_invoice_to_paid_inherit</field>
          <field name="model">account.payment</field>
          <field name="inherit_id" ref="account.view_account_payment_form"/>
          <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
              <!-- MIGRACIÓN V19: `invoice_line_ids` nunca fue un campo real
                   de `account.payment` (no usa `_inherits` hacia
                   `account.move`); era una declaración muerta ya en 15.0.
                   Se quita, pues el validador de vistas de 19.0 rechaza
                   campos inexistentes. -->
              <field name="amount_rest" invisible="1"/>
              <!-- MIGRACIÓN V19: `account.payment.state` ya no tiene el
                   valor `posted` -en 19.0 el flujo es draft/in_process/
                   paid/canceled/rejected (ver `_compute_state` en
                   `addons/account/models/account_payment.py`)-, así que
                   `state != 'posted'` era siempre verdadero y el botón
                   quedaba oculto sin importar `amount_rest`. El
                   equivalente de "posted" (confirmado, no cancelado) es
                   cualquier estado con asiento contable creado:
                   `in_process` o `paid`. -->
              <button name="asign_invoices" type="object" string="Asignar Facturas" invisible="state not in ('in_process', 'paid') or amount_rest == 0"/>
            </xpath>
          </field>
        </record>


  </data>
</odoo>
